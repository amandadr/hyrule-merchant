---
import BaseLayout from '@/components/BaseLayout.astro';
import BrewBench from '@/components/brew/BrewBench';
import {
  getAllEntries,
  getCookables,
  getMerchantStaples,
  getProducts,
  getRecipes,
  getRegions,
} from '@/lib/content';
import { stapleToMaterialEntry } from '@/lib/data/enrich';
import { isElixirCritter } from '@/lib/brew/resolve';
import { getDailyExperiment } from '@/lib/brew/daily';

const recipes = getRecipes();
const staples = getMerchantStaples();
const cookables = getCookables();
const regions = getRegions();
const allEntries = getAllEntries();
const monsters = allEntries.filter((entry) => entry.category === 'monsters');
const daily = getDailyExperiment(recipes);
const products = getProducts().map((product) => ({
  slug: product.slug,
  sourceId: product.sourceId,
  name: product.entry.name,
  priceRupees: product.priceRupees,
  stockStatus: product.stockStatus,
}));

const pickerItems = [
  ...cookables.map((entry) => {
    const base = {
      sourceId: entry.sourceId,
      name: entry.name,
      image: entry.image,
      commonLocations: entry.commonLocations,
      group:
        entry.category === 'materials'
          ? ('material' as const)
          : ('creature' as const),
      isCritter: isElixirCritter(entry),
    };
    if (entry.category === 'materials') {
      return {
        ...base,
        cookingEffect: entry.cookingEffect || undefined,
        heartsRecovered: entry.heartsRecovered,
      };
    }
    if (entry.category === 'creatures' && entry.edible === true) {
      return {
        ...base,
        cookingEffect: entry.cookingEffect || undefined,
        heartsRecovered: entry.heartsRecovered,
      };
    }
    return base;
  }),
  ...staples.map((staple) => {
    const entry = stapleToMaterialEntry(staple);
    return {
      sourceId: staple.sourceId,
      stapleId: staple.stapleId,
      name: staple.name,
      image: entry.image,
      cookingEffect: staple.cookingEffect || undefined,
      heartsRecovered: staple.heartsRecovered,
      commonLocations: staple.commonLocations,
      group: 'staple' as const,
    };
  }),
  ...monsters.map((entry) => ({
    sourceId: entry.sourceId,
    name: entry.name,
    image: entry.image,
    commonLocations: entry.commonLocations,
    group: 'monster' as const,
    isMonsterPart: true,
  })),
];
---

<BaseLayout title="Brew">
  <div class="page">
    <header class="section-head">
      <p class="kicker">The wagon</p>
      <h1>Brewing bench</h1>
      <p class="muted">
        Start with today’s challenge, or choose a named recipe and fill the pot.
        Meals use materials, seafood, and pantry staples. An elixir needs a
        critter with an effect and a monster part.
      </p>
    </header>

    {
      daily ? (
        <section class="primary-section" aria-labelledby="bench-challenge">
          <div class="section-head">
            <p class="kicker">Today</p>
            <h2 id="bench-challenge">Bench challenge</h2>
            <p>{daily.blurb}</p>
          </div>
          <p>
            <a class="button button-primary" href={`#${daily.recipe.slug}`}>
              Open {daily.recipe.name}
            </a>
          </p>
        </section>
      ) : null
    }

    <BrewBench
      client:load
      pickerItems={pickerItems}
      recipes={recipes}
      staples={staples}
      entries={[...allEntries, ...staples.map(stapleToMaterialEntry)]}
      regions={regions}
      products={products}
    />
  </div>
</BaseLayout>
