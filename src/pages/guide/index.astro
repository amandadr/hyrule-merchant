---
import BaseLayout from '@/components/BaseLayout.astro';
import { getAllEntries, getCategories, getCategoryCounts } from '@/lib/content';
import { titleCaseName } from '@/lib/data/normalize';
import { categoryCover } from '@/lib/visuals/covers';

const counts = getCategoryCounts();
const entries = getAllEntries();
const categories = getCategories();

const categoryBlurb: Record<string, string> = {
  creatures: 'Wildlife, fish, and critters — some cook, some drop parts.',
  materials: 'Forage, ore, and monster parts for the pot and the pack.',
  equipment: 'Arms and tools the wagon may stock.',
  monsters: 'Threats and sourcing notes — not for sale.',
  treasure: 'Chests, deposits, and salvage leads.',
};
---

<BaseLayout title="Field Manual">
  <div class="page">
    <header class="section-head">
      <p class="kicker">Working notes</p>
      <h1>Field Manual</h1>
      <p class="muted">
        Pick a category. Open a record to buy it, see which roads know it, or
        cook with it.
      </p>
    </header>
    <ul class="grid-list">
      {
        categories.map((category) => {
          const cover = categoryCover(category, entries);
          return (
            <li class="entry-card media-card">
              <a href={`/guide/${category}`}>
                {
                  cover ? (
                    <img
                      class="cover-image"
                      src={cover.image}
                      alt=""
                      width="280"
                      height="180"
                      loading="lazy"
                    />
                  ) : null
                }
                <div class="media-card-body">
                  <strong>{titleCaseName(category)}</strong>
                  <div class="muted">{counts[category]} entries</div>
                  <div class="muted">{categoryBlurb[category] ?? ''}</div>
                  {
                    cover ? (
                      <div class="muted cover-caption">Pictured: {cover.label}</div>
                    ) : null
                  }
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>
