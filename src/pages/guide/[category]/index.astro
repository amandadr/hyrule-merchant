---
import BaseLayout from '@/components/BaseLayout.astro';
import GuideFilters from '@/components/guide/GuideFilters';
import { titleCaseName } from '@/lib/data/normalize';
import {
  getAllEntries,
  getCategories,
  getEntriesByCategory,
  isEntryCategory,
} from '@/lib/content';
import { categoryCover } from '@/lib/visuals/covers';
import {
  collectEffects,
  collectLocations,
  toGuideCardEntry,
} from '@/lib/guide/filter';

export function getStaticPaths() {
  return getCategories().map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;

if (!category || !isEntryCategory(category)) {
  throw new Error(`Unknown guide category: ${category}`);
}

const entries = getEntriesByCategory(category).map(toGuideCardEntry);
const locations = collectLocations(entries);
const effects = collectEffects(entries);
const showEdible = category === 'creatures';
const showDrops =
  category === 'creatures' || category === 'monsters' || category === 'treasure';
const showHeartsSort = category === 'materials' || category === 'creatures';
const categoryLabel = titleCaseName(category);
const cover = categoryCover(category, getAllEntries());
---

<BaseLayout title={`${categoryLabel} · Field Manual`}>
  <div class="page">
    <p class="back-link"><a href="/guide">← Field Manual</a></p>
    <header class="subject-hero">
      {
        cover ? (
          <img
            class="subject-hero-image"
            src={cover.image}
            alt=""
            width="160"
            height="160"
          />
        ) : null
      }
      <div class="section-head">
        <p class="kicker">Field Manual</p>
        <h1>{categoryLabel}</h1>
        <p class="muted">
          {entries.length} records. Open one to see if Sorrel sells it, which roads
          know it, and which recipes or packs use it.
        </p>
        {
          cover ? (
            <p class="muted cover-caption">Pictured: {cover.label}</p>
          ) : null
        }
      </div>
    </header>
    <GuideFilters
      client:load
      category={category}
      entries={entries}
      locations={locations}
      effects={effects}
      showEdible={showEdible}
      showDrops={showDrops}
      showHeartsSort={showHeartsSort}
    />
  </div>
</BaseLayout>

