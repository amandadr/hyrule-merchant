---
import BaseLayout from '@/components/BaseLayout.astro';
import EntryDetail from '@/components/EntryDetail.astro';
import {
  getAllEntries,
  getEntryBySlug,
  getMerchantStaples,
  getOutfits,
  getProducts,
  getRecipes,
  getRegions,
  isEntryCategory,
} from '@/lib/content';
import { buildGuideRelationships } from '@/lib/guide/relationships';
import { titleCaseName } from '@/lib/data/normalize';

export function getStaticPaths() {
  return getAllEntries().map((entry) => ({
    params: {
      category: entry.category,
      slug: entry.slug,
    },
  }));
}

const { category, slug } = Astro.params;

if (!category || !isEntryCategory(category) || !slug) {
  throw new Error(`Invalid guide route: ${category}/${slug}`);
}

const entry = getEntryBySlug(category, slug);

if (!entry) {
  throw new Error(`Unknown guide entry: ${category}/${slug}`);
}

const displayName = titleCaseName(entry.name);
const categoryLabel = titleCaseName(entry.category);
const relationships = buildGuideRelationships(entry, {
  products: getProducts(),
  entries: getAllEntries(),
  regions: getRegions(),
  recipes: getRecipes(),
  outfits: getOutfits(),
  staples: getMerchantStaples(),
});

const hasHandoffs =
  relationships.product ||
  relationships.locations.length > 0 ||
  relationships.drops.length > 0 ||
  relationships.droppedBy.length > 0 ||
  relationships.recipes.length > 0 ||
  relationships.packs.length > 0;
---

<BaseLayout title={displayName}>
  <div class="page">
    <p class="back-link">
      <a href={`/guide/${entry.category}`}>← {categoryLabel}</a>
    </p>
    <header class="sidebar">
      <img class="frame" src={entry.image} alt="" width="128" height="128" />
      <div class="section-head">
        <p class="kicker">Field Manual · {categoryLabel}</p>
        <h1>{displayName}</h1>
        <p>{entry.description}</p>
      </div>
    </header>

    {
      hasHandoffs ? (
        <section class="primary-section" aria-labelledby="from-the-wagon">
          <div class="section-head">
            <p class="kicker">Next</p>
            <h2 id="from-the-wagon">From the wagon</h2>
            <p class="muted">
              Where to go next: the shop, a road, a recipe, or a pack.
            </p>
          </div>

          {
            relationships.product ? (
              <div class="stack stack-tight">
                <h3>Sold here?</h3>
                <p>
                  <a href={relationships.product.href}>
                    {relationships.product.label}
                  </a>
                  {
                    relationships.product.note ? (
                      <span class="muted"> — {relationships.product.note}</span>
                    ) : null
                  }
                </p>
              </div>
            ) : null
          }

          {
            relationships.locations.length > 0 ? (
              <div class="stack stack-tight">
                <h3>Roads that know this place</h3>
                <ul class="guide-handoff-list">
                  {relationships.locations.map((link) => (
                    <li>
                      {link.href ? (
                        <a href={link.href}>{link.label}</a>
                      ) : (
                        link.label
                      )}
                      {link.note ? (
                        <span class="muted"> — {link.note}</span>
                      ) : null}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          {
            relationships.drops.length > 0 ? (
              <div class="stack stack-tight">
                <h3>Drops worth following</h3>
                <ul class="guide-handoff-list">
                  {relationships.drops.map((link) => (
                    <li>
                      {link.href ? (
                        <a href={link.href}>{link.label}</a>
                      ) : (
                        link.label
                      )}
                      {link.note ? (
                        <span class="muted"> — {link.note}</span>
                      ) : null}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          {
            relationships.droppedBy.length > 0 ? (
              <div class="stack stack-tight">
                <h3>Dropped by</h3>
                <ul class="guide-handoff-list">
                  {relationships.droppedBy.map((link) => (
                    <li>
                      {link.href ? (
                        <a href={link.href}>{link.label}</a>
                      ) : (
                        link.label
                      )}
                      {link.note ? (
                        <span class="muted"> — {link.note}</span>
                      ) : null}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          {
            relationships.recipes.length > 0 ? (
              <div class="stack stack-tight">
                <h3>Finishes these recipes</h3>
                <ul class="guide-handoff-list">
                  {relationships.recipes.map((link) => (
                    <li>
                      {link.href ? (
                        <a href={link.href}>{link.label}</a>
                      ) : (
                        link.label
                      )}
                      {link.note ? (
                        <span class="muted"> — {link.note}</span>
                      ) : null}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          {
            relationships.packs.length > 0 ? (
              <div class="stack stack-tight">
                <h3>Journey packs</h3>
                <ul class="guide-handoff-list">
                  {relationships.packs.map((link) => (
                    <li>
                      {link.href ? (
                        <a href={link.href}>{link.label}</a>
                      ) : (
                        link.label
                      )}
                      {link.note ? (
                        <span class="muted"> — {link.note}</span>
                      ) : null}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }
        </section>
      ) : null
    }

    <section class={hasHandoffs ? 'reference' : 'section'}>
      <div class="section-head">
        <h2>In the field</h2>
        <p class="muted">
          {
            hasHandoffs
              ? 'Where it is found, and what it does.'
              : 'Sorrel has nowhere else to send you for this. Use the notes to decide if the road is worth it.'
          }
        </p>
      </div>
      <EntryDetail
        entry={entry}
        regions={getRegions()}
        showImage={false}
        showDescription={false}
        nested
      />
    </section>
  </div>
</BaseLayout>
