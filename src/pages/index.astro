---
import BaseLayout from '@/components/BaseLayout.astro';
import RegionRoadCard from '@/components/regions/RegionRoadCard.astro';
import {
  KOROK_NAME,
  MERCHANT_NAME,
  MERCHANT_SHORT,
  SITE_NAME,
  SITE_TAGLINE,
} from '@/config/site';
import {
  getAllEntries,
  getOutfits,
  getProductsBySourceId,
  getRecipes,
  getRegions,
} from '@/lib/content';
import { getDailyExperiment } from '@/lib/brew/daily';
import { kitFace } from '@/lib/journey/packs';
import { titleCaseName } from '@/lib/data/normalize';
import { regionCover } from '@/lib/visuals/covers';

const regions = getRegions();
const entries = getAllEntries();
const productsBySourceId = getProductsBySourceId();
const outfits = getOutfits().filter((outfit) => outfit.regionSlug);
const daily = getDailyExperiment(getRecipes());

/** A few contrasting roads for the destination-first start. */
const featuredSlugs = ['dueling-peaks', 'hebra', 'gerudo'];
const featured = featuredSlugs
  .map((slug) => {
    const region = regions.find((item) => item.slug === slug);
    const pack = outfits.find((item) => item.regionSlug === slug);
    if (!region || !pack) return null;
    return {
      region,
      pack,
      cover: regionCover(region.slug, entries),
      kitItems: kitFace(pack, productsBySourceId),
    };
  })
  .filter((item): item is NonNullable<typeof item> => item != null);
---

<BaseLayout title="Home" description={SITE_TAGLINE}>
  <div class="page home-page">
    <section class="home-hero">
      <div class="home-hero-copy stack">
        <p class="kicker">Travelling outfitter · field notes · brewing bench</p>
        <h1>{SITE_NAME}</h1>
        <p class="home-tagline">{SITE_TAGLINE}</p>
        <div class="home-merchant-beat">
          <img
            class="sorrel-portrait home-portrait"
            src="/images/Sorrel.png"
            alt={`${MERCHANT_NAME}, the merchant`}
            width="64"
            height="64"
          />
          <p>
            <strong>{MERCHANT_NAME}</strong> — {MERCHANT_SHORT} to the Koroks —
            packs what the road actually asks for. {KOROK_NAME} insists on the
            detours.{' '}
            <a href="/merchant">Meet the merchant</a>
          </p>
        </div>
        <div class="home-cta-row">
          <a class="button button-primary" href="/regions">
            Where are you headed?
          </a>
          {
            daily ? (
              <a class="button" href={`/brew#${daily.recipe.slug}`}>
                Today’s bench challenge
              </a>
            ) : (
              <a class="button" href="/brew">
                Open the brewing bench
              </a>
            )
          }
        </div>
        {
          daily ? (
            <p class="home-daily-blurb muted">{daily.blurb}</p>
          ) : null
        }
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Pick a road</h2>
        <p class="muted">
          Open a road, read what the weather and the hazards ask for, and take
          the pack Sorrel recommends. You can change it in your satchel.
        </p>
      </div>
      <ul class="grid-list">
        {
          featured.map(({ region, pack, cover, kitItems }) => (
            <RegionRoadCard
              href={`/regions/${region.slug}`}
              title={titleCaseName(region.name)}
              detail={pack.objective}
              packName={pack.name}
              cover={cover}
              kitItems={kitItems}
            />
          ))
        }
      </ul>
      <p>
        <a href="/regions">All {regions.length} destinations →</a>
      </p>
    </section>

    <section class="section">
      <h2>Or start another way</h2>
      <ul class="home-secondary-links">
        <li>
          <a href="/shop">Shop the shelves</a>
          <span class="muted">When you already know what you need</span>
        </li>
        <li>
          <a href="/brew">Brew a meal or elixir</a>
          <span class="muted">Cook, fail safely, buy the pot</span>
        </li>
        <li>
          <a href="/guide">Browse the Field Manual</a>
          <span class="muted">Look something up, then jump to the shop or a road</span>
        </li>
        <li>
          <a href="/satchel">Open your satchel</a>
          <span class="muted">See what you are carrying, then what else to add</span>
        </li>
      </ul>
    </section>

  </div>
</BaseLayout>
