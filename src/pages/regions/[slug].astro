---
import BaseLayout from '@/components/BaseLayout.astro';
import JourneyPackCard from '@/components/journey/JourneyPackCard';
import {
  getAllEntries,
  getOutfitsForRegion,
  getProductBySourceId,
  getProductsBySourceId,
  getRegionBySlug,
  getRegions,
} from '@/lib/content';
import { regionSlugForLocation } from '@/lib/brew/regions';
import { resolveJourneyPack, toPackCardPayload } from '@/lib/journey/packs';
import { titleCaseName } from '@/lib/data/normalize';
import { regionCover } from '@/lib/visuals/covers';

export function getStaticPaths() {
  return getRegions().map((region) => ({
    params: { slug: region.slug },
  }));
}

const { slug } = Astro.params;
const region = getRegionBySlug(slug!);

if (!region) {
  throw new Error(`Unknown region slug: ${slug}`);
}

const displayName = titleCaseName(region.name);
const cover = regionCover(region.slug, getAllEntries());
const decisionNotes = [
  { label: 'Conditions', value: region.conditions },
  { label: 'Hazards', value: region.hazards },
  { label: 'Useful finds', value: region.usefulFinds },
];
const referenceNotes = [
  { label: 'Route notes', value: region.routeNotes },
  { label: 'Merchant story', value: region.merchantStory },
].filter((block) => block.value);

const productsBySourceId = getProductsBySourceId();
const packs = getOutfitsForRegion(region.slug)
  .map((outfit) => resolveJourneyPack(outfit, productsBySourceId))
  .filter((pack) => pack.items.length > 0)
  .map(toPackCardPayload);

const allRegions = getRegions();
const nearbyFinds = getAllEntries()
  .filter((entry) =>
    entry.commonLocations.some(
      (location) => regionSlugForLocation(location, allRegions) === region.slug,
    ),
  )
  .filter((entry) => entry.category === 'materials' || entry.category === 'creatures')
  .slice(0, 6)
  .map((entry) => {
    const product = getProductBySourceId(entry.sourceId);
    const sellable =
      product &&
      product.stockStatus !== 'not_sold' &&
      product.stockStatus !== 'guide_only';
    return {
      label: titleCaseName(entry.name),
      image: entry.image,
      href: sellable
        ? `/shop/${product.slug}`
        : `/guide/${entry.category}/${entry.slug}`,
      note: sellable ? 'Shop' : 'Field Manual',
    };
  });
---

<BaseLayout title={displayName}>
  <div class="page">
    <p class="back-link"><a href="/regions">← Regions</a></p>
    <header class="sidebar">
      {
        cover ? (
          <img
            class="frame"
            src={cover.image}
            alt=""
            width="128"
            height="128"
          />
        ) : null
      }
      <div class="section-head">
        <p class="kicker">Destination</p>
        <h1>{displayName}</h1>
        {
          region.overview ? (
            <p>{region.overview}</p>
          ) : (
            <p class="muted">Sor hasn’t written an overview for this road yet.</p>
          )
        }
        {
          cover ? (
            <p class="muted cover-caption">Pictured: {cover.label}</p>
          ) : null
        }
      </div>
    </header>

    <section class="section" aria-labelledby="before-you-pack">
      <div class="section-head">
        <h2 id="before-you-pack">Before you pack</h2>
        <p class="muted">Read these before you take the pack.</p>
      </div>
      <dl class="decision-notes">
        {
          decisionNotes.map((block) => (
            <div class="decision-note">
              <dt>{block.label}</dt>
              <dd>
                {block.value || 'Sor hasn’t written these notes up yet.'}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      packs.length > 0 ? (
        <section class="section" aria-labelledby="journey-pack">
          <div class="section-head">
            <p class="kicker">Recommended</p>
            <h2 id="journey-pack">Journey pack</h2>
            <p class="muted">Add the whole pack, then change anything in your satchel.</p>
          </div>
          <div class="stack is-decision">
            {packs.map((pack) => (
              <JourneyPackCard client:load pack={pack} />
            ))}
          </div>
        </section>
      ) : null
    }

    {
      nearbyFinds.length > 0 ? (
        <section class="section" aria-labelledby="nearby-finds">
          <div class="section-head">
            <h2 id="nearby-finds">Often found near here</h2>
            <p class="muted">
              Open one in the shop if Sorrel sells it, or in the Field Manual to read the record.
            </p>
          </div>
          <ul class="find-list">
            {
              nearbyFinds.map((find) => (
                <li>
                  <a href={find.href}>
                    <img
                      src={find.image}
                      alt=""
                      width="64"
                      height="64"
                      loading="lazy"
                    />
                    <span>
                      <strong>{find.label}</strong>
                      <span class="muted">{find.note}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      ) : null
    }

    <section class="reference" aria-labelledby="field-reference">
      <div class="section-head">
        <h2 id="field-reference">Field reference</h2>
        <p class="muted">
          The longer notes, settlements, and shrines. When you know what to carry,{' '}
          <a href="/shop">shop the shelves</a>
          {' or '}
          <a href="/guide">look it up in the Field Manual</a>.
        </p>
      </div>
      {
        referenceNotes.map((block) => (
          <div class="prose">
            <h3>{block.label}</h3>
            <p>{block.value}</p>
          </div>
        ))
      }
      <div class="split">
        <div class="stack">
          <h3>Settlements</h3>
          {
            region.settlements.length > 0 ? (
              <ul>
                {region.settlements.map((settlement) => (
                  <li>{titleCaseName(settlement)}</li>
                ))}
              </ul>
            ) : (
              <p class="muted">None listed.</p>
            )
          }
        </div>
        <div class="stack">
          <h3>Shrines</h3>
          {
            region.shrines.length > 0 ? (
              <ul>
                {
                  region.shrines.map((shrine) => (
                    <li>
                      {titleCaseName(shrine.name)}
                      <span class="muted"> — {shrine.puzzle}</span>
                    </li>
                  ))
                }
              </ul>
            ) : (
              <p class="muted">None listed.</p>
            )
          }
        </div>
        {
          region.dlcShrines.length > 0 && (
            <div class="stack">
              <h3>DLC shrines</h3>
              <ul>
                {region.dlcShrines.map((shrine) => (
                  <li>
                    {titleCaseName(shrine.name)}
                    <span class="muted"> — {shrine.puzzle}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>
