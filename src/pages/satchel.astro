---
import BaseLayout from '@/components/BaseLayout.astro';
import { SatchelPanel } from '@/components/satchel/SatchelWidgets';
import SatchelRecommendations from '@/components/satchel/SatchelRecommendations';
import {
  getAllEntries,
  getMerchantStapleEntries,
  getMerchantStaples,
  getOutfits,
  getProducts,
  getRecipes,
  getRegions,
} from '@/lib/content';

const products = getProducts();
const recipes = getRecipes();
const regions = getRegions();
const outfits = getOutfits();
const staples = getMerchantStaples();
const entries = [...getAllEntries(), ...getMerchantStapleEntries()];

// Slim, authoritative lookup so satchel rows can show thumbnails and current
// scarcity without migrating the persisted store shape.
const itemIndex = Object.fromEntries(
  products.map((product) => [
    product.slug,
    {
      image: product.entry.image,
      category: product.entry.category,
      origin: product.origin,
      stockStatus: product.stockStatus,
      cookingEffect:
        'cookingEffect' in product.entry ? product.entry.cookingEffect ?? '' : '',
    },
  ]),
);
---

<BaseLayout title="My Satchel">
  <div class="stack">
    <h1>My Satchel</h1>
    <SatchelPanel client:load itemIndex={itemIndex} />
    <SatchelRecommendations
      client:load
      products={products}
      recipes={recipes}
      regions={regions}
      outfits={outfits}
      staples={staples}
      entries={entries}
    />
  </div>
</BaseLayout>
