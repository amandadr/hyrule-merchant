---
import BaseLayout from '@/components/BaseLayout.astro';
import KitStrip from '@/components/KitStrip.astro';
import ShopFilters, { toShopCard } from '@/components/shop/ShopFilters';
import {
  getMerchantStaples,
  getOutfits,
  getProducts,
  getRecipes,
  getAllEntries,
  getMerchantStapleEntries,
  getRegions,
} from '@/lib/content';
import { resolveRecipeSlots } from '@/lib/brew/resolve';
import { kitFace } from '@/lib/journey/packs';
import { titleCaseName } from '@/lib/data/normalize';

const products = getProducts().filter(
  (product) =>
    product.stockStatus !== 'not_sold' && product.stockStatus !== 'guide_only',
);
const outfits = getOutfits();
const recipes = getRecipes().filter((recipe) => recipe.kind !== 'failure');
const entries = [...getAllEntries(), ...getMerchantStapleEntries()];
const staples = getMerchantStaples();
const regions = getRegions();
const regionNameBySlug = new Map(
  regions.map((region) => [region.slug, titleCaseName(region.name)]),
);

const recipeIngredientIds = new Map<string, Set<number>>();
for (const recipe of recipes) {
  const resolved = resolveRecipeSlots(recipe, entries, staples);
  recipeIngredientIds.set(recipe.slug, new Set(resolved.exampleSourceIds));
}

const cards = products.map((product) => {
  const outfitSlugs = outfits
    .filter((outfit) => outfit.sourceIds.includes(product.sourceId))
    .map((outfit) => outfit.slug);
  const recipeSlugs = [...recipeIngredientIds.entries()]
    .filter(([, ids]) => ids.has(product.sourceId))
    .map(([slug]) => slug);
  return toShopCard(product, outfitSlugs, recipeSlugs);
});

const stockStatuses = [...new Set(products.map((p) => p.stockStatus))].sort();
const effects = [
  ...new Set(
    cards
      .map((card) => card.cookingEffect)
      .filter((effect): effect is string => Boolean(effect)),
  ),
].sort();
const categories = [...new Set(cards.map((card) => card.category))].sort();
const stapleCount = products.filter((p) => p.origin === 'merchant_staple').length;

const featuredPackSlugs = [
  'dueling-peaks-first-trip',
  'hebra-cold-kit',
  'gerudo-lightning',
  'trail-skewer-kit',
];
const productsBySourceId = new Map(
  products.map((product) => [product.sourceId, product]),
);
const featuredPacks = featuredPackSlugs
  .map((slug) => outfits.find((outfit) => outfit.slug === slug))
  .filter((outfit): outfit is NonNullable<typeof outfit> => Boolean(outfit))
  .map((outfit) => ({
    slug: outfit.slug,
    name: outfit.name,
    objective: outfit.objective,
    href: outfit.regionSlug
      ? `/regions/${outfit.regionSlug}`
      : `/shop?outfit=${outfit.slug}`,
    regionLabel: outfit.regionSlug
      ? regionNameBySlug.get(outfit.regionSlug)
      : 'Any road',
    kitItems: kitFace(outfit, productsBySourceId),
  }));
---

<BaseLayout title="Shop">
  <div class="page">
    <header class="section-head">
      <p class="kicker">The wagon</p>
      <h1>Shop</h1>
      <p class="muted">
        Start with a pack if you have a road in mind, or search the shelves
        when you already know the name. {products.length} goods, including {stapleCount} pantry
        staples.
      </p>
    </header>

    <section class="primary-section" aria-labelledby="sor-recommends">
      <div class="section-head">
        <p class="kicker">Recommended</p>
        <h2 id="sor-recommends">Sor recommends</h2>
        <p class="muted">
          Open the road to take the whole pack, or show just those goods here.
        </p>
      </div>
      <ul class="shop-featured-list">
        {
          featuredPacks.map((pack) => (
            <li class="entry-card media-card">
              <a href={pack.href}>
                <KitStrip items={pack.kitItems} label={`${pack.name} contents`} size="banner" />
                <div class="media-card-body">
                  <strong>{pack.name}</strong>
                  <div class="muted">{pack.regionLabel}</div>
                  <div class="muted">{pack.objective}</div>
                </div>
              </a>
              <p class="entry-card-action">
                <a href={`/shop?outfit=${pack.slug}`}>Show pack goods →</a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <ShopFilters
      client:load
      products={cards}
      stockStatuses={stockStatuses}
      effects={effects}
      categories={categories}
      outfits={outfits.map((outfit) => ({
        slug: outfit.slug,
        name: outfit.name,
      }))}
      recipes={recipes.map((recipe) => ({
        slug: recipe.slug,
        name: recipe.name,
      }))}
    />
  </div>
</BaseLayout>
