---
import BaseLayout from '@/components/BaseLayout.astro';
import EntryDetail from '@/components/EntryDetail.astro';
import AddToSatchelButton from '@/components/satchel/SatchelWidgets';
import { ProductMeta } from '@/components/shop/ProductBadges';
import {
  getOutfits,
  getProductBySlug,
  getProducts,
  getRecipes,
  getRegions,
  getMerchantStaples,
} from '@/lib/content';
import { titleCaseName } from '@/lib/data/normalize';
import { recipeOverlapScore } from '@/lib/brew/evaluate';
import { regionSlugForLocation } from '@/lib/brew/regions';

export function getStaticPaths() {
  return getProducts().map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug!);

if (!product) {
  throw new Error(`Unknown product slug: ${slug}`);
}

const displayName = titleCaseName(product.entry.name);
const isStaple = product.origin === 'merchant_staple';
const products = getProducts();
const staples = getMerchantStaples();
const recipes = getRecipes();
const outfits = getOutfits();

function cookingEffectOf(entry: (typeof product)['entry']): string {
  if (entry.category === 'materials') return entry.cookingEffect || '';
  if (entry.category === 'creatures' && entry.edible === true) {
    return entry.cookingEffect || '';
  }
  return '';
}

const effect = cookingEffectOf(product.entry);
const hearts =
  product.entry.category === 'materials'
    ? product.entry.heartsRecovered
    : product.entry.category === 'creatures' && product.entry.edible === true
      ? product.entry.heartsRecovered
      : undefined;
const shelf = isStaple
  ? 'staples'
  : product.entry.category === 'equipment'
    ? 'equipment'
    : product.entry.category === 'creatures' || product.entry.category === 'monsters'
      ? 'creatures'
      : 'materials';

const relatedProducts = products
  .filter((candidate) => candidate.slug !== product.slug)
  .filter((candidate) => {
    const sharedLoc = candidate.entry.commonLocations.some((loc) =>
      product.entry.commonLocations.includes(loc),
    );
    const sharedEffect =
      effect && cookingEffectOf(candidate.entry) === effect;
    return sharedLoc || sharedEffect;
  })
  .slice(0, 3);

const relatedRecipes = recipes
  .filter((recipe) => recipe.kind !== 'failure')
  .map((recipe) => ({
    recipe,
    overlap: recipeOverlapScore(recipe, new Set([product.sourceId]), staples),
  }))
  .filter(({ overlap }) => overlap.have > 0)
  .sort((a, b) => b.overlap.have - a.overlap.have)
  .slice(0, 2)
  .map(({ recipe, overlap }) => ({ recipe, overlap }));

const relatedOutfits = outfits.filter((outfit) =>
  outfit.sourceIds.includes(product.sourceId),
);
const regions = getRegions();
const sourcedNear = product.entry.commonLocations.slice(0, 4);
const shelfLabel =
  shelf === 'staples'
    ? 'Pantry staple'
    : shelf === 'equipment'
      ? 'Equipment'
      : shelf === 'creatures'
        ? 'Creature'
        : 'Material';
const hasRelated =
  relatedProducts.length > 0 ||
  relatedRecipes.length > 0 ||
  relatedOutfits.length > 0;
---

<BaseLayout title={displayName}>
  <div class="page">
    <p class="back-link"><a href="/shop">← Shop</a></p>
    <header class="sidebar">
      <img
        class="frame"
        src={product.entry.image}
        alt=""
        width="128"
        height="128"
      />
      <div class="stack stack-tight">
        <p class="kicker">{shelfLabel}</p>
        <h1>{displayName}</h1>
        <ProductMeta
          client:load
          priceRupees={product.priceRupees}
          stockStatus={product.stockStatus}
          origin={product.origin}
          category={product.entry.category}
          cookingEffect={effect || undefined}
          heartsRecovered={hearts}
          shelf={shelf}
          compactPrice={false}
          emphasizePrice
        />
        <p>{product.merchantNote}</p>
        <p>{product.entry.description}</p>
        {
          sourcedNear.length > 0 ? (
            <p class="muted">
              Sourced near:{' '}
              {sourcedNear.map((location, index) => {
                const regionSlug = regionSlugForLocation(location, regions);
                const prefix = index > 0 ? ', ' : '';
                return regionSlug ? (
                  <span>
                    {prefix}
                    <a href={`/regions/${regionSlug}`}>{location}</a>
                  </span>
                ) : (
                  <span>
                    {prefix}
                    {location}
                  </span>
                );
              })}
            </p>
          ) : null
        }
        <AddToSatchelButton
          client:load
          productSlug={product.slug}
          sourceId={product.sourceId}
          name={displayName}
          priceRupees={product.priceRupees}
          stockStatus={product.stockStatus}
        />
      </div>
    </header>

    <section class="reference">
      <div class="section-head">
        <h2>{isStaple ? 'From the pantry' : 'In the field'}</h2>
        {
          isStaple ? (
            <p class="muted">
              Sorrel keeps this in the pantry. You will not find it growing wild.
            </p>
          ) : (
            <p class="muted">Where it is found, and how it cooks or holds up.</p>
          )
        }
      </div>
      <EntryDetail
        entry={product.entry}
        regions={regions}
        showImage={false}
        showDescription={false}
        nested
      />
    </section>

    {
      hasRelated ? (
        <section class="section" aria-labelledby="carry-with">
          <div class="section-head">
            <h2 id="carry-with">Carry it with</h2>
            <p class="muted">Other goods, recipes, and packs that call for this.</p>
          </div>

          {
            relatedProducts.length > 0 ? (
              <div class="stack stack-tight">
                <h3>Pairs well with</h3>
                <ul class="grid-list">
                  {relatedProducts.map((related) => (
                    <li class="entry-card">
                      <a href={`/shop/${related.slug}`}>
                        <img
                          src={related.entry.image}
                          alt=""
                          width="64"
                          height="64"
                          loading="lazy"
                        />
                        <strong>{titleCaseName(related.entry.name)}</strong>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          {
            relatedRecipes.length > 0 ? (
              <div class="stack stack-tight">
                <h3>Finishes these recipes</h3>
                <ul class="bare-list">
                  {relatedRecipes.map(({ recipe, overlap }) => (
                    <li class="entry-card">
                      <a href={`/brew#${recipe.slug}`}>
                        <strong>{recipe.name}</strong>
                        <div class="muted">
                          You would have {overlap.have} of {overlap.need} ingredients
                          with this alone.
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          {
            relatedOutfits.length > 0 ? (
              <div class="stack stack-tight">
                <h3>Journey packs</h3>
                <ul class="bare-list">
                  {relatedOutfits.map((outfit) => (
                    <li class="entry-card">
                      <a
                        href={
                          outfit.regionSlug
                            ? `/regions/${outfit.regionSlug}`
                            : `/shop?outfit=${outfit.slug}`
                        }
                      >
                        <strong>{outfit.name}</strong>
                        <div class="muted">{outfit.objective}</div>
                        <div class="muted">{outfit.merchantNote}</div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }
        </section>
      ) : null
    }
  </div>
</BaseLayout>
