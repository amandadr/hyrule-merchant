---
import { titleCaseName, type SourceEntry } from '@/lib/data/normalize';

interface Props {
  entry: SourceEntry;
  href: string;
}

const { entry, href } = Astro.props;
---

<li class="entry-card">
  <a href={href}>
    <img
      src={entry.image}
      alt={titleCaseName(entry.name)}
      width="80"
      height="80"
      loading="lazy"
    />
    <strong>{titleCaseName(entry.name)}</strong>
    <div class="muted"><span class="badge">{entry.category}</span></div>
  </a>
</li>
