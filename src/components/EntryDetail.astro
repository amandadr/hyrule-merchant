---
import type { Region, SourceEntry } from '@/lib/data/normalize';
import { titleCaseName } from '@/lib/data/normalize';
import { regionSlugForLocation } from '@/lib/brew/regions';

interface Props {
  entry: SourceEntry;
  regions?: Region[];
  /** Hide the image when the page hero already shows it. */
  showImage?: boolean;
  /** Hide the description when the page hero already shows it. */
  showDescription?: boolean;
  /** Use h3 when this block sits under another section heading. */
  nested?: boolean;
}

const {
  entry,
  regions = [],
  showImage = true,
  showDescription = true,
  nested = false,
} = Astro.props;
const displayName = titleCaseName(entry.name);
const FactHeading = nested ? 'h3' : 'h2';
---

<section class={showImage ? 'detail-layout' : 'stack'}>
  {
    showImage ? (
      <img class="frame" src={entry.image} alt={displayName} width="128" height="128" />
    ) : null
  }
  <div class="stack">
    <p class="cluster muted">
      <span class="badge">{titleCaseName(entry.category)}</span>
    </p>
    {showDescription ? <p>{entry.description}</p> : null}

    {
      entry.commonLocations.length > 0 ? (
        <div class="stack stack-tight">
          <FactHeading>Common locations</FactHeading>
          <ul>
            {entry.commonLocations.map((location) => {
              const regionSlug = regionSlugForLocation(location, regions);
              return (
                <li>
                  {regionSlug ? (
                    <a href={`/regions/${regionSlug}`}>{location}</a>
                  ) : (
                    location
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ) : (
        <p class="muted">Common locations unknown.</p>
      )
    }

    {
      entry.category === 'creatures' && entry.edible === true && (
        <div class="stack stack-tight">
          <FactHeading>Cooking</FactHeading>
          <ul>
            <li>Effect: {entry.cookingEffect || 'none'}</li>
            <li>Hearts recovered: {entry.heartsRecovered}</li>
          </ul>
        </div>
      )
    }

    {
      entry.category === 'creatures' && entry.edible === false && (
        <div class="stack stack-tight">
          <FactHeading>Drops</FactHeading>
          {entry.drops.length > 0 ? (
            <ul>
              {entry.drops.map((drop) => (
                <li>{titleCaseName(drop)}</li>
              ))}
            </ul>
          ) : (
            <p class="muted">No drops listed.</p>
          )}
        </div>
      )
    }

    {
      entry.category === 'materials' && (
        <div class="stack stack-tight">
          <FactHeading>Cooking</FactHeading>
          <ul>
            <li>Effect: {entry.cookingEffect || 'none'}</li>
            <li>Hearts recovered: {entry.heartsRecovered}</li>
          </ul>
        </div>
      )
    }

    {
      entry.category === 'equipment' && (
        <div class="stack stack-tight">
          <FactHeading>Properties</FactHeading>
          <ul>
            <li>Attack: {entry.properties.attack}</li>
            <li>Defense: {entry.properties.defense}</li>
            {entry.properties.type ? <li>Type: {entry.properties.type}</li> : null}
            {entry.properties.effect ? <li>Effect: {entry.properties.effect}</li> : null}
          </ul>
        </div>
      )
    }

    {
      (entry.category === 'monsters' || entry.category === 'treasure') && (
        <div class="stack stack-tight">
          <FactHeading>Drops</FactHeading>
          {entry.drops.length > 0 ? (
            <ul>
              {entry.drops.map((drop) => (
                <li>{titleCaseName(drop)}</li>
              ))}
            </ul>
          ) : (
            <p class="muted">No drops listed.</p>
          )}
        </div>
      )
    }
  </div>
</section>
